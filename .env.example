# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The PoC runs with provider=mock (config.yaml) WITHOUT any of these.

# === Claude via Azure AI Foundry (the provider we use) ===================
# Set provider: foundry in config.yaml, then put ONLY the key here.
# The endpoint and model (claude-sonnet-4-6) are non-secret and live in config.yaml.
ANTHROPIC_FOUNDRY_API_KEY=
# Optional: override the endpoint from config.yaml (usually leave blank).
ANTHROPIC_FOUNDRY_ENDPOINT=

# === Azure OpenAI (alternative provider; not used by default) ============
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/

# === Anthropic direct (Wave 2) ===========================================
ANTHROPIC_API_KEY=
